# Admin dashboard password (required - set a strong password)
REACT_APP_ADMIN_PASSWORD=

# Backend email service URL
REACT_APP_BACKEND_URL=http://localhost:5001

# Optional: lead tracking API endpoint
REACT_APP_TRACKING_API=

# Optional: Google Sheets Apps Script URL for lead sync
REACT_APP_GOOGLE_SHEETS_URL=

# --- Backend (backend/.env) ---
PORT=5001
CORS_ORIGIN=http://localhost:3000,https://yourdomain.com
ZOHO_EMAIL=
ZOHO_PASSWORD=
NODE_ENV=development
