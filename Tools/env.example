# React App Environment Variables

# API Configuration
REACT_APP_API_URL=http://localhost:8000/api

# VAPID Public Key for Push Notifications (Replace with your own)
REACT_APP_VAPID_PUBLIC_KEY=your-vapid-public-key-here

# Environment Settings
REACT_APP_ENVIRONMENT=development
REACT_APP_DEBUG=false

# Analytics (Optional)
REACT_APP_GOOGLE_ANALYTICS_ID=your-ga-id-here

# Error Reporting (Optional)
REACT_APP_SENTRY_DSN=your-sentry-dsn-here
